From 6a64c403c10eede2118150a0479f3133bb7b0357 Mon Sep 17 00:00:00 2001
From: Brian <happyknightgaming@gmail.com>
Date: Fri, 30 Oct 2026 02:09:27 -0400
Subject: [PATCH] Clamp path sample index to valid segment

---
 .../pathplanner/lib/path/PathPlannerPath.cpp  |  2 +-
 .../lib/path/PathSamplingRegressionTest.cpp   | 20 +++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)
 create mode 100644 pathplannerlib/src/test/native/cpp/pathplanner/lib/path/PathSamplingRegressionTest.cpp

diff --git a/pathplannerlib/src/main/native/cpp/pathplanner/lib/path/PathPlannerPath.cpp b/pathplannerlib/src/main/native/cpp/pathplanner/lib/path/PathPlannerPath.cpp
index b29948b..8fd8172 100644
--- a/pathplannerlib/src/main/native/cpp/pathplanner/lib/path/PathPlannerPath.cpp
+++ b/pathplannerlib/src/main/native/cpp/pathplanner/lib/path/PathPlannerPath.cpp
@@ -917,7 +917,7 @@ frc::Translation2d PathPlannerPath::samplePath(
 		double waypointRelativePos) const {
 	double pos = std::clamp(waypointRelativePos, 0.0, m_waypoints.size() - 1.0);
 
-	size_t i = static_cast<size_t>(waypointRelativePos);
+	size_t i = static_cast<size_t>(pos);
 	if (i == m_waypoints.size() - 1) {
 		i--;
 	}
diff --git a/pathplannerlib/src/test/native/cpp/pathplanner/lib/path/PathSamplingRegressionTest.cpp b/pathplannerlib/src/test/native/cpp/pathplanner/lib/path/PathSamplingRegressionTest.cpp
new file mode 100644
index 0000000..4e21728
--- /dev/null
+++ b/pathplannerlib/src/test/native/cpp/pathplanner/lib/path/PathSamplingRegressionTest.cpp
@@ -0,0 +1,20 @@
+#include <gtest/gtest.h>
+#include <pathplanner/lib/path/PathPlannerPath.h>
+#include <pathplanner/lib/path/PathConstraints.h>
+#include <pathplanner/lib/path/GoalEndState.h>
+#include <numbers>
+using namespace units::literals;
+
+TEST(PathPlannerPathTest, SamplesShortFinalSegmentWithoutIndexingPastWaypoints) {
+  const frc::Translation2d start{0_m,0_m}, corner{.5_m,0_m};
+  const frc::Rotation2d turn{units::radian_t{std::numbers::pi/4}};
+  const auto goal=corner+frc::Translation2d{.3_m,turn};
+  const auto before=corner*.8+start*.2, after=corner*.8+goal*.2;
+  const std::vector<frc::Pose2d> poses{{start,(corner-start).Angle()},
+      {before,(corner-start).Angle()},{after,(goal-after).Angle()},{goal,(goal-corner).Angle()}};
+  auto waypoints=pathplanner::PathPlannerPath::waypointsFromPoses(poses);
+  pathplanner::PathPlannerPath path(waypoints,{2_mps,3_mps_sq,3_rad_per_s,6_rad_per_s_sq},
+                                    std::nullopt,{0_mps,frc::Rotation2d{}});
+  ASSERT_FALSE(path.getAllPathPoints().empty());
+  EXPECT_LT(path.getAllPathPoints().back().position.Distance(goal).value(),1e-9);
+}
-- 
2.56.0

